{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI uvicorn",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.gateway.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
