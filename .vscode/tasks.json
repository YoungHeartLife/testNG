{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MVP: smoke check",
      "type": "shell",
      "command": "bash scripts/local-smoke.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MVP: setup VSCode local deps",
      "type": "shell",
      "command": "bash scripts/vscode-setup.sh",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Backend: dev server",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && cd .. && PYTHONPATH=. uvicorn backend.gateway.main:app --reload --host 0.0.0.0 --port 8000",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev server",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: compose up",
      "type": "shell",
      "command": "docker compose up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: compose down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
