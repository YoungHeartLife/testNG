# AI 情绪交易系统：DeepSeek + SQLite 纯后端配置
DATABASE_PATH=data/ai_trading.sqlite3
SCAN_INTERVAL_SECONDS=3600
TOP_N=20
# auto=false-like behavior: when AkShare works, use AkShare; set true to force demo data
USE_DEMO_DATA=auto

# 爬取数据源，多个URL用英文逗号分隔；支持普通HTML页面或RSS
CRAWL_URLS=
CRAWL_LIMIT=10

# DeepSeek AI；不配置Key时自动使用本地规则AI兜底，流程仍可跑通
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 实时通知：留空则只在终端实时输出；配置后每次扫描后POST JSON到Webhook
NOTIFY_ENABLED=true
NOTIFY_WEBHOOK_URL=
