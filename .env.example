# AI 情绪交易系统 MVP 本地测试环境变量

# Frontend -> Backend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Backend services
PYTHONPATH=/app
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aitrading
REDIS_URL=redis://redis:6379/0

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aitrading

# Optional: PushPlus token for /api/report/push. Do not commit real tokens.
PUSHPLUS_TOKEN=

# Optional: JSON array for holdings analysis, or point HOLDINGS_FILE to data/holdings.json.
# HOLDINGS_JSON=[{"stock":"000001","name":"平安银行","cost":10.0,"last_price":10.5,"quantity":1000,"buy_reason":"缩量回踩均价线"}]
HOLDINGS_FILE=data/holdings.json

# Optional: TuShare token. When installed/configured, future data adapters can use it for official market data.
TUSHARE_TOKEN=
